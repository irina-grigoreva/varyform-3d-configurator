# VARYFORM environment template. Copy to .env for local development.
# Never commit real credentials; production values belong in the hosting provider's secret store.

# --- Fastify API (apps/api) -------------------------------------------------
# PostgreSQL connection string. Local Docker uses trust auth; managed hosts need
# credentials and usually ?sslmode=require. Server-side only - never exposed to Nuxt.
DATABASE_URL=postgres://varyform@localhost:5432/varyform
API_HOST=0.0.0.0
API_PORT=3001
# Browser origin(s) allowed by API CORS. Comma-separated, no trailing slash.
WEB_ORIGIN=http://localhost:3000
# production | development. Production logs at info level.
NODE_ENV=development
# Optional: debug | info | warn | error (defaults: debug in development, info in production).
LOG_LEVEL=
# Set to true behind a managed reverse proxy (Render/Railway/Fly) so rate limits use client IPs.
TRUST_PROXY=false

# --- Nuxt frontend (apps/web) -----------------------------------------------
# Public values: they are embedded in the browser bundle.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# WordPress/WooCommerce shop origin. Empty disables the Add to cart button.
NUXT_PUBLIC_WORDPRESS_URL=http://localhost:8080

# --- WordPress bridge --------------------------------------------------------
# The plugin is configured in WooCommerce -> Settings -> VARYFORM (stored in the
# WordPress database), not via this file:
#   API Base URL      = public Fastify origin without /api
#   Configurator URL  = public Nuxt origin (also the only allowed REST CORS origin)
#   Product ID        = published simple product used as the cart container
#   API timeout       = 1-20 seconds
